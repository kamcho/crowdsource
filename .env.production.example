# ==================================================================
# PRODUCTION .env  (copy this to `.env` ON THE DROPLET and fill in)
#   cp .env.production.example .env && nano .env
# NEVER commit the real .env to git.
# ==================================================================

# --- Core Django ---
# Generate:  python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_generate_a_long_random_secret
DEBUG=False

# Domain(s) and/or droplet IP, comma-separated (no spaces, no scheme)
ALLOWED_HOSTS=kenyaimports.com,www.kenyaimports.com,161.35.111.174

# CSRF origins — https after Certbot; http kept for IP access during transition
CSRF_TRUSTED_ORIGINS=https://kenyaimports.com,https://www.kenyaimports.com,http://kenyaimports.com,http://www.kenyaimports.com,http://161.35.111.174

# SEO / sitemap (no scheme, no trailing slash)
SITE_NAME=Kenya Imports
SITE_DOMAIN=kenyaimports.com
SITE_PROTOCOL=https

# --- PostgreSQL ---
DB_ENGINE=postgres
DB_NAME=crowdsource
DB_USER=crowdsource
DB_PASSWORD=CHANGE_ME_strong_db_password
DB_HOST=127.0.0.1
DB_PORT=5432

# --- HTTPS hardening (set after Certbot) ---
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000

# --- Google Sign-In ---
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# --- OpenAI (AI product import) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Payments ---
PAYMENT_PROVIDER=mpesa
USD_TO_KES_RATE=135

# --- M-Pesa Daraja ---
MPESA_ENVIRONMENT=production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=4161900
MPESA_CALLBACK_BASE_URL=https://kenyaimports.com

# --- Notifications ---
NOTIFICATION_BACKEND=textsms
NOTIFICATION_SMS_ENABLED=true
NOTIFICATION_EMAIL_ENABLED=true
TEXTSMS_ENABLED=true
TEXTSMS_API_KEY=
TEXTSMS_PARTNER_ID=
TEXTSMS_SHORTCODE=

# --- Email (SMTP) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.yourprovider.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=CrowdSource Import <noreply@kenyaimports.com>
