# ==================================================================
# PRODUCTION .env  (copy this to `.env` ON THE DROPLET and fill in)
#   cp .env.production.example .env && nano .env
# NEVER commit the real .env to git.
# ==================================================================

# --- Core Django ---
# Generate:  python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_generate_a_long_random_secret
DEBUG=False

# Domain(s) and/or droplet IP, comma-separated (no spaces, no scheme)
ALLOWED_HOSTS=YOUR_DOMAIN,www.YOUR_DOMAIN,DROPLET_IP

# CSRF origins — include http until Certbot HTTPS is enabled, then prefer https
CSRF_TRUSTED_ORIGINS=http://YOUR_DOMAIN,http://www.YOUR_DOMAIN,https://YOUR_DOMAIN,https://www.YOUR_DOMAIN,http://DROPLET_IP

# --- PostgreSQL ---
DB_ENGINE=postgres
DB_NAME=crowdsource
DB_USER=crowdsource
DB_PASSWORD=CHANGE_ME_strong_db_password
DB_HOST=127.0.0.1
DB_PORT=5432

# --- HTTPS hardening ---
# Leave SECURE_SSL_REDIRECT=False until Certbot has issued a certificate.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# --- Google Sign-In ---
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# --- Payments ---
PAYMENT_PROVIDER=mpesa
USD_TO_KES_RATE=135

# --- M-Pesa Daraja ---
MPESA_ENVIRONMENT=production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=4161900
MPESA_CALLBACK_BASE_URL=https://YOUR_DOMAIN

# --- Notifications ---
NOTIFICATION_BACKEND=textsms
NOTIFICATION_SMS_ENABLED=true
NOTIFICATION_EMAIL_ENABLED=true
TEXTSMS_ENABLED=true
TEXTSMS_API_KEY=
TEXTSMS_PARTNER_ID=
TEXTSMS_SHORTCODE=

# --- Email (SMTP) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.yourprovider.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=CrowdSource Import <noreply@YOUR_DOMAIN>
