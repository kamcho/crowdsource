DEBUG=True

SECRET_KEY=change-me-in-production

ALLOWED_HOSTS=localhost,127.0.0.1



# Google OAuth Web Client ID (from Google Cloud Console)

GOOGLE_CLIENT_ID=



# Payments

# Dev: PAYMENT_PROVIDER=demo (instant fake payment)

# Prod: PAYMENT_PROVIDER=mpesa + Daraja credentials below

PAYMENT_PROVIDER=demo

USD_TO_KES_RATE=135



# M-Pesa Daraja (Paybill) — copy from Excel project .env

MPESA_ENVIRONMENT=production

MPESA_CONSUMER_KEY=

MPESA_CONSUMER_SECRET=

MPESA_PASSKEY=

MPESA_SHORTCODE=4161900

# Public HTTPS base URL (ngrok in dev, your domain in prod)

MPESA_CALLBACK_BASE_URL=



# Database — omit DB_ENGINE for local SQLite; set postgres on droplet

# DB_ENGINE=postgres

# DB_NAME=crowdsource

# DB_USER=crowdsource

# DB_PASSWORD=

# DB_HOST=127.0.0.1

# DB_PORT=5432



# CSRF (production — add your domain after deploy)

# CSRF_TRUSTED_ORIGINS=https://yourdomain.com



# Notifications

NOTIFICATION_BACKEND=console

NOTIFICATION_SMS_ENABLED=true

NOTIFICATION_EMAIL_ENABLED=true

DEFAULT_FROM_EMAIL=noreply@crowdsource.local



# TextSMS (textsms.co.ke)

TEXTSMS_ENABLED=false

TEXTSMS_API_KEY=

TEXTSMS_PARTNER_ID=

TEXTSMS_SHORTCODE=

